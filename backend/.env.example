# Copier vers backend/.env et renseigner les valeurs locales.
# Ne jamais committer le fichier .env.

# Obligatoire — chaîne aléatoire longue (ex. openssl rand -hex 32)
SIGU_SECRET_KEY=

# PostgreSQL (runtime / Alembic)
# Exemple staging : postgresql+psycopg://sigu:…@localhost:5432/sigu
SIGU_DATABASE_URL=postgresql+psycopg://sigu:CHANGE_ME@localhost:5432/sigu

# Base PostgreSQL de TEST dédiée SIGU (jamais une base d’un autre projet).
# Obligatoire pour le smoke d’intégration I1. Préfixes imposés :
#   - nom de base : sigu_test_*
#   - utilisateur  : sigu_test_*
# Exemple : postgresql+psycopg://sigu_test_user:…@127.0.0.1:5433/sigu_test_i1
# SIGU_TEST_DATABASE_URL=

# Avant alembic upgrade sur une base de test : imposer le garde-fou sigu_test_*
# SIGU_MIGRATION_REQUIRE_TEST_DB=1

# Campagne I1 : si TEST et DATABASE sont tous deux définis, ils doivent
# désigner la même cible (hôte/port/base/utilisateur).

# Environnement : development | staging | production
SIGU_ENVIRONMENT=development

# Cookie JWT (httpOnly) — Secure=true obligatoire derrière HTTPS en production
SIGU_ACCESS_COOKIE_NAME=sigu_access
SIGU_ACCESS_TOKEN_EXPIRE_MINUTES=60
SIGU_COOKIE_SECURE=false
SIGU_COOKIE_SAMESITE=lax

# CORS — origines du futur sigu-web / outils locaux (séparées par des virgules)
SIGU_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Limitation login (mémoire processus ; 0 tentatives = désactivé)
SIGU_LOGIN_RATE_LIMIT_ATTEMPTS=5
SIGU_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Bootstrap admin ponctuel (script create_admin) — ne pas laisser renseigné en permanence
# SIGU_BOOTSTRAP_EMAIL=
# SIGU_BOOTSTRAP_PASSWORD=
